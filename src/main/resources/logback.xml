<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 一些设置 -->
    <property name="CONSOLE_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Console格式 -->
    <!--写入日志到控制台的appender-->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- DJL -->
    <logger name="ai.djl" level="DEBUG"/>

    <!-- ONNX -->
    <logger name="ai.onnxruntime" level="DEBUG"/>

    <!-- OpenCV -->
    <logger name="nu.pattern" level="TRACE"/>

    <!-- 项目日志 -->
    <logger name="com.ty" level="INFO"/>
    <logger name="com.ty.ai.cv.paddlepaddle.translator" level="INFO"/>

    <!-- 根日志 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>